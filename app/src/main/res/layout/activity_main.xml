<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stock_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/stock_navy"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="StockFácil PC"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Inventario de artículos de computación"
            android:textColor="#D5E2F0"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignOut"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Cerrar sesión"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:text="Cargando datos del portal…"
        android:textColor="@color/stock_text" android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServerSettings"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Configurar conexion"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/pageDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen del inventario"
                    android:textColor="@color/stock_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Estado actual de tus productos"
                    android:textColor="@color/stock_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1"
                        android:layout_marginEnd="6dp" app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="14dp" app:strokeColor="#E2E8EF" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Productos" android:textColor="@color/stock_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvStatProducts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="—" android:textColor="@color/stock_text" android:textSize="24sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1"
                        android:layout_marginStart="6dp" app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="14dp" app:strokeColor="#E2E8EF" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unidades" android:textColor="@color/stock_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvStatUnits" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="—" android:textColor="@color/stock_text" android:textSize="24sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="14dp" app:strokeColor="#E2E8EF" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stock bajo" android:textColor="@color/stock_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvStatLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="—" android:textColor="#A65B00" android:textSize="24sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="94dp" android:layout_weight="1" android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="14dp" app:strokeColor="#E2E8EF" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="13dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Categorías" android:textColor="@color/stock_muted" android:textSize="12sp" />
                            <TextView android:id="@+id/tvStatCategories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="—" android:textColor="@color/stock_text" android:textSize="24sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="14dp" app:strokeColor="#E2E8EF" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alertas de stock" android:textColor="@color/stock_text" android:textSize="16sp" android:textStyle="bold" />
                        <LinearLayout android:id="@+id/llLowStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@android:color/white" app:cardCornerRadius="14dp" app:strokeColor="#E2E8EF" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Movimientos recientes" android:textColor="@color/stock_text" android:textSize="16sp" android:textStyle="bold" />
                        <LinearLayout android:id="@+id/llRecentMovements" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/pageProducts"
            android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Productos" android:textColor="@color/stock_text" android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddProduct" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nuevo producto" android:textSize="12sp" app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnStockMovement" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:text="Mover stock" android:textSize="12sp" app:cornerRadius="12dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSendPending" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Enviar al portal" android:textSize="12sp" app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRefreshPortal" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Actualizar" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/tvPendingCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin productos pendientes" android:textColor="@color/stock_muted" android:textSize="12sp" />
            <TextView android:id="@+id/tvProductCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:text="0 productos" android:textColor="@color/stock_text" android:textStyle="bold" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buscar por nombre o código" app:boxBackgroundMode="outline" app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionSearch" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/tvEmptyState" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="24dp" android:text="Aún no hay productos. Agrega el primero para empezar." android:textColor="@color/stock_muted" android:textSize="15sp" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvProducts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:clipToPadding="false" android:paddingBottom="10dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <ScrollView android:id="@+id/pageCategories" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Categorías" android:textColor="@color/stock_text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Organización del inventario" android:textColor="@color/stock_muted" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Nueva categoría" app:cornerRadius="12dp" />
                <LinearLayout android:id="@+id/llCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView android:id="@+id/pageMovements" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Movimientos" android:textColor="@color/stock_text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Historial de ingresos y salidas" android:textColor="@color/stock_muted" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddMovement" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Registrar movimiento" app:cornerRadius="12dp" />
                <LinearLayout android:id="@+id/llMovements" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:itemIconTint="@color/stock_green"
        app:itemTextColor="@color/stock_green"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
